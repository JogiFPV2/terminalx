{
  "id": "tx.pomodoro",
  "name": "Pomodoro",
  "version": "1.0.0",
  "apiVersion": 1,
  "main": "main.js",
  "author": "Hermitty",
  "description": "Licznik pracy i przerw na pasku statusu z powiadomieniem.",
  "icon": "timer",
  "permissions": ["ui:statusbar", "ui:commands", "notifications"],
  "contributes": {
    "statusBar": [{ "id": "pomodoro", "alignment": "right", "priority": 60 }],
    "commands": [
      { "id": "pomodoro.toggle", "title": "Pomodoro: start / pauza", "keybinding": "Ctrl+Alt+P" },
      { "id": "pomodoro.reset", "title": "Pomodoro: reset" }
    ]
  },
  "config": {
    "workMinutes": 25,
    "breakMinutes": 5,
    "autoStartBreak": false
  }
}
