{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hermitty",
  "version": "../../package.json",
  "identifier": "app.hermitty.mobile",
  "build": {
    "beforeDevCommand": { "script": "npm run mobile:dev", "cwd": "../.." },
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": { "script": "npm run mobile:build", "cwd": "../.." },
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Hermitty" }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "android": { "minSdkVersion": 29 }
  }
}
